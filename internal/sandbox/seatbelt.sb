(version 1)
(deny default)
; Apple dyld-support.sb documents that libignition opens / as an openat root.
; Literal access permits opening/listing this directory, never its descendants.
(allow file-read* (literal "/"))
; Kernel-enforced filesystem restrictions are inherited by spawned processes.
(allow process-fork process-exec)
; Required during runtime startup. This rule alone does NOT confine procargs.
; profile() appends the tested process-info family denial after ALL grants.
(allow process-info* (target self))
(allow signal (target self) (target same-sandbox))
; Hardware/OS discovery only. Never expose kern.procargs or other processes' env.
(allow sysctl-read
    (sysctl-name-prefix "hw.")
    (sysctl-name-prefix "machdep.cpu.")
    (sysctl-name-prefix "kern.os")
    (sysctl-name "kern.maxfilesperproc" "kern.argmax" "kern.hostname"
                 "kern.proc_translated" "kern.usrstack64" "kern.boottime"
                 "kern.version"))
; No general Mach, keychain, launchd, Apple Events or host Unix-socket access.
(allow mach-lookup
    (global-name "com.apple.system.notification_center")
    (global-name "com.apple.system.logger")
    (global-name "com.apple.system.opendirectoryd.libinfo")
    (global-name "com.apple.SystemConfiguration.configd")
    (global-name "com.apple.mDNSResponder"))
; Networking permissions are added by the profile builder for its selected mode.
(allow file-read* file-write* file-map-executable
    (subpath (param "WORKSPACE"))
    (subpath (param "PRIVATE_HOME"))
    (subpath (param "PRIVATE_TMP")))
(allow file-read* file-write-data file-ioctl
    (literal "/dev/null")
    (literal "/dev/tty"))
(allow file-read* (literal "/dev/random") (literal "/dev/urandom"))
